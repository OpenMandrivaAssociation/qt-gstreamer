+macro(_qt6_component_names_to_target_link_libraries output_list)
+  foreach(module ${ARGN})
+    _qt4or5_component_name_to_qt_component(qt_component ${module})
+    list(APPEND ${output_list} Qt6::${qt_component})
+    if (${qt_component} STREQUAL "OpenGL")
+      list(APPEND ${output_list} Qt6::OpenGLWidgets)
+    endif()
+    unset(qt_component)
+  endforeach()
+
+  list(REMOVE_DUPLICATES ${output_list})
+endmacro()
